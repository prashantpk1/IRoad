              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/driver/auth/reset-password/",
            "description": "Set new password after OTP verified. `new_password` and `confirm_password` must match (min 8 chars)."
          },
          "response": []
        }
      ]
    },
