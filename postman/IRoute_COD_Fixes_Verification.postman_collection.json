              "    return r.data || r;",
              "};",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('SH-COD-29789621 NOT in pending list', () => {",
              "    const body = getData();",
              "    const results = body.items || [];",
              "    const nos = results.map(r => r.shipment_no || '');",
              "    pm.expect(nos).to.not.include('SH-COD-29789621');",
              "});"
            ]
          }
        }
      ]
    },
