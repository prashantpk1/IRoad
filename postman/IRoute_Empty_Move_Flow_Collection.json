  "item": [
    {
      "name": "01 — Login (Get Access Token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{driver_email}}\",\n  \"password\": \"{{driver_password}}\",\n  \"tenant_id\": \"{{tenant_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/driver/auth/login/",
        "description": "EMAIL LOGIN — Use this OR Request 01b for phone login.\nOnly run one login request per session.\n\nSTEP 1 — SAME LOGIN AS JOB FLOW.\nSend email, password, tenant_id.\naccess_token is auto-saved.\nToken key in response is data.access_token.\nUse Authorization: Bearer {{access_token}} for all subsequent calls.\nSet driver_email in collection variables before running.\n\nAlternative body (phone login — use Request 01b instead):\n{\n  \"extension\": \"{{driver_extension}}\",\n  \"phone\": \"{{driver_phone}}\",\n  \"password\": \"{{driver_password}}\",\n  \"tenant_id\": \"{{tenant_id}}\"\n}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var resp = pm.response.json();",
              "if (resp.status === 1 && resp.data && resp.data.access_token) {",
              "    pm.collectionVariables.set(\"access_token\", resp.data.access_token);",
              "    pm.test(\"Login successful, token saved\", function() { pm.expect(resp.status).to.eql(1); });",
              "} else {",
              "    pm.test(\"Login FAILED — check credentials\", function() { pm.expect(resp.status).to.eql(1); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "01b — Login via Phone Number (Alternative)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"extension\": \"{{driver_extension}}\",\n  \"phone\": \"{{driver_phone}}\",\n  \"password\": \"{{driver_password}}\",\n  \"tenant_id\": \"{{tenant_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/driver/auth/login/",
        "description": "ALTERNATIVE LOGIN — USE PHONE NUMBER INSTEAD OF EMAIL.\n\nUse this request if the driver does not have an email\nor prefers to login with phone number.\n\nRequired fields:\n  extension = country code e.g. +966 or +91\n  phone = phone number without extension e.g. 987456321\n  password = driver password\n\nSet driver_extension and driver_phone in\ncollection variables before running.\n\nSame response as email login.\naccess_token is auto-saved after success.\n\nOnly run ONE login request (01 or 01b).\nBoth save the same access_token variable."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var resp = pm.response.json();",
              "if (resp.status === 1 && resp.data &&",
              "    resp.data.access_token) {",
              "    pm.collectionVariables.set(",
              "        \"access_token\", resp.data.access_token",
              "    );",
              "    pm.collectionVariables.set(",
              "        \"refresh_token\", resp.data.refresh_token",
              "    );",
              "    pm.test(\"Login successful, token saved\",",
              "        function() {",
              "            pm.expect(resp.status).to.eql(1);",
              "        }",
              "    );",
              "} else {",
              "    pm.test(\"Login FAILED — check credentials\",",
              "        function() {",
              "            pm.expect(resp.status).to.eql(1);",
              "        }",
              "    );",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Dashboard (Check for Empty Move or On Call State)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/driver/dashboard/",
        "description": "If no empty move exists, run 02a List Locations then 02b Create Empty Move."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var resp = pm.response.json();",
              "var d = resp.data || {};",
              "var em = d.current_empty_move || {};",
              "var aj = d.active_job || {};",
              "var movementId = em.movement_id || em.job_id || (aj.job_type === 'movement' ? aj.job_id : '');",
              "if (movementId) {",
              "    pm.collectionVariables.set('movement_job_id', movementId);",
              "    pm.test('movement_job_id saved', function() { pm.expect(movementId).to.exist; });",
              "}",
              "if (d.sync_metadata) {",
              "    if (d.sync_metadata.content_hash) pm.collectionVariables.set('content_hash', d.sync_metadata.content_hash);",
              "    if (d.sync_metadata.workflow_version) pm.collectionVariables.set('workflow_version', d.sync_metadata.workflow_version);",
              "}",
              "if (!movementId) {",
              "    pm.test('No current empty move — driver in On Call mode, ready to start new empty move', function() { pm.expect(true).to.be.true; });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02a — List Empty Move Locations (get UUIDs)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Accept-Language",
            "value": "en"
          }
        ],
        "url": "{{base_url}}/driver/empty-moves/locations/?search={{location_search}}&limit=50",
        "description": "GET location UUIDs for pickup/delivery pickers.\n\nRun this BEFORE 02b. Test script auto-sets:\n  pickup_location_id   (matches pickup_location_search, default jeddah)\n  delivery_location_id (matches delivery_location_search, default makkah)\n\nMobile app must use location_id from this API — NOT map numeric place IDs."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var resp = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "var locs = (resp.data && resp.data.locations) || [];",
              "pm.test('At least one location returned', function () { pm.expect(locs.length).to.be.above(0); });",
              "function pickLocation(term) {",
              "    var needle = (term || '').trim().toLowerCase();",
              "    if (!needle) return null;",
              "    for (var i = 0; i < locs.length; i++) {",
              "        var loc = locs[i] || {};",
              "        var hay = ((loc.label || '') + ' ' + (loc.display_name || '') + ' ' + (loc.province || '')).toLowerCase();",
              "        if (hay.indexOf(needle) >= 0) return loc.location_id;",
              "    }",
              "    return null;",
              "}",
              "var pickupSearch = pm.collectionVariables.get('pickup_location_search') || 'jeddah';",
              "var deliverySearch = pm.collectionVariables.get('delivery_location_search') || 'makkah';",
              "var pickupId = pickLocation(pickupSearch) || (locs[0] && locs[0].location_id);",
              "var deliveryId = pickLocation(deliverySearch) || (locs[1] && locs[1].location_id) || pickupId;",
              "if (pickupId) pm.collectionVariables.set('pickup_location_id', pickupId);",
              "if (deliveryId) pm.collectionVariables.set('delivery_location_id', deliveryId);",
              "console.log('pickup_location_id=', pickupId);",
              "console.log('delivery_location_id=', deliveryId);"
            ]
          }
        }
      ]
    },
    {
      "name": "02b-live — Create Empty Move (Live GPS + Address — no Location UUIDs)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Accept-Language",
            "value": "en"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"empty_move_reason\": \"{{empty_move_reason}}\",\n  \"from_address\": \"{{from_address}}\",\n  \"from_latitude\": {{pickup_latitude}},\n  \"from_longitude\": {{pickup_longitude}},\n  \"to_address\": \"{{to_address}}\",\n  \"to_latitude\": {{delivery_latitude}},\n  \"to_longitude\": {{delivery_longitude}},\n  \"client_action_id\": \"em-create-live-{{$guid}}\",\n  \"notes\": \"{{empty_move_notes}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/driver/empty-moves/",
        "description": "LIVE LOCATION MODE — GPS + reverse-geocoded address.\n\nDo NOT send from_location_id / to_location_id.\n\nREQUIRED: from_address + from_latitude + from_longitude AND to_address + to_latitude + to_longitude.\n\nOn success (201): saves movement_job_id. Status Scheduled — run 04a EM1 to start pickup."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var resp = pm.response.json();",
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "if (resp.status === 1 && resp.data && resp.data.empty_move) {",
              "    var em = resp.data.empty_move;",
              "    pm.collectionVariables.set('movement_job_id', em.movement_id || em.job_id);",
              "    pm.test('Empty move created (live location)', function () {",
              "        pm.expect(em.movement_no).to.exist;",
              "    });",
              "    pm.test('From location has GPS stored on TML', function () {",
              "        pm.expect(em.from_location.latitude).to.exist;",
              "        pm.expect(em.from_location.longitude).to.exist;",
              "        pm.expect(em.from_location.label).to.exist;",
              "    });",
              "    pm.test('To location has GPS stored on TML', function () {",
              "        pm.expect(em.to_location.latitude).to.exist;",
              "        pm.expect(em.to_location.longitude).to.exist;",
              "        pm.expect(em.to_location.label).to.exist;",
              "    });",
              "    pm.test('workflow_started is false until driver runs EM1', function () {",
              "        pm.expect(em.workflow_started).to.eql(false);",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02b — Create Empty Move (Tenant Location UUIDs + GPS)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Accept-Language",
            "value": "en"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"empty_move_reason\": \"{{empty_move_reason}}\",\n  \"from_location_id\": \"{{pickup_location_id}}\",\n  \"to_location_id\": \"{{delivery_location_id}}\",\n  \"from_latitude\": {{pickup_latitude}},\n  \"from_longitude\": {{pickup_longitude}},\n  \"to_latitude\": {{delivery_latitude}},\n  \"to_longitude\": {{delivery_longitude}},\n  \"client_action_id\": \"em-create-{{$guid}}\",\n  \"notes\": \"{{empty_move_notes}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/driver/empty-moves/",
        "description": "POST /driver/empty-moves/ — creates TML in Scheduled status.\n\nPREREQUISITE: Run 02a for pickup_location_id and delivery_location_id UUIDs.\n\nDriver starts pickup manually via 04a EM1."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var resp = pm.response.json();",
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "if (resp.status === 1 && resp.data && resp.data.empty_move) {",
              "    var em = resp.data.empty_move;",
              "    pm.collectionVariables.set(\"movement_job_id\", em.movement_id || em.job_id);",
              "    pm.test(\"Empty move created\", function() {",
              "        pm.expect(em.movement_no).to.exist;",
              "    });",
              "    pm.test('workflow_started is false until driver runs EM1', function() {",
              "        pm.expect(em.workflow_started).to.eql(false);",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Empty Move Job Detail (Current State)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/driver/jobs/movement/{{movement_job_id}}/",
        "description": "GET empty move detail after 02b create.\nStatus should be Scheduled until EM1.\nSaves content_hash and workflow_version for execute calls.\nAssert allowed actions include EM1 (Start at Pickup)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var resp = pm.response.json();",
              "if (resp.data && resp.data.job && resp.data.job.job_id) {",
              "    pm.collectionVariables.set('movement_job_id', resp.data.job.job_id);",
              "}",
              "if (resp.data && resp.data.sync_metadata) {",
              "    pm.collectionVariables.set(",
              "        \"content_hash\",",
              "        resp.data.sync_metadata.content_hash",
              "    );",
              "    pm.collectionVariables.set(",
              "        \"workflow_version\",",
              "        resp.data.sync_metadata.workflow_version",
              "    );",
              "    pm.test(",
              "        \"Sync metadata saved for empty move execute\",",
              "        function() {",
              "            pm.expect(resp.data.sync_metadata.content_hash).to.exist;",
              "        }",
              "    );",
              "}",
              "pm.test(\"Allowed actions contains EM1 (pickup start)\", function() {",
              "    var allowed = (resp.data && resp.data.workflow && resp.data.workflow.allowed_actions) || [];",
              "    var codes = allowed.map(function(a) { return a.action_code; });",
              "    pm.expect(codes).to.include(\"EM1\");",
              "});",
              "if (resp.data && resp.data.workflow && resp.data.workflow.workflow_status) {",
              "    pm.test(\"Pickup step not completed before EM1\", function() {",
              "        var pickup = resp.data.workflow.workflow_status.find(function(s) { return s.step_key === 'pickup'; });",
              "        pm.expect(pickup && pickup.completed).to.eql(false);",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Empty Move Timeline (Action History)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/driver/jobs/movement/{{movement_job_id}}/timeline/",
        "description": "STEP 4 — OPTIONAL: VIEW ACTION HISTORY FOR THIS MOVE.\nShows all actions fired on this empty move in reverse chronological order.\nUseful for debugging or confirming what has already fired.\nCan be called at any point during the empty move flow."
      }
    },
    {
      "name": "04a — Execute EM1 Start at Pickup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_action_id\": \"{{execute_client_action_id}}\",\n  \"workflow_version\": \"{{workflow_version}}\",\n  \"content_hash\": \"{{content_hash}}\",\n  \"latitude\": {{pickup_latitude}},\n  \"longitude\": {{pickup_longitude}},\n  \"notes\": \"Start empty move at Pickup\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/driver/jobs/movement/{{movement_job_id}}/actions/EM1/execute/",
        "description": "Driver confirms pickup / starts movement. Pickup step turns green after this."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function requireVar(name) {",
              "    var v = pm.collectionVariables.get(name) || '';",
              "    if (!v || String(v).indexOf('{{') >= 0) { throw new Error(name + ' missing — run 01, 02b, 03 first.'); }",
              "}",
              "requireVar('movement_job_id'); requireVar('content_hash'); requireVar('workflow_version'); requireVar('access_token');",
              "pm.collectionVariables.set('execute_client_action_id', 'em-start-' + pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var resp = pm.response.json();",
              "var exec = (resp.data && resp.data.execution) || {};",
              "pm.test('Status 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "pm.test('Not a cross-job replay', function () {",
              "    if (exec.replayed) { pm.expect(exec.replayed).to.eql(false); }",
              "});",
              "pm.test('Next action is EM2', function () {",
              "    var next = (resp.data.workflow && resp.data.workflow.next_action) || {};",
              "    pm.expect(next.action_code).to.eql('EM2');",
              "});",
              "if (resp.status === 1 && resp.data && resp.data.sync_metadata) {",
              "    pm.collectionVariables.set('content_hash', resp.data.sync_metadata.content_hash);",
              "    pm.collectionVariables.set('workflow_version', resp.data.sync_metadata.workflow_version);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Execute EM2 Depart Empty",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_action_id\": \"{{execute_client_action_id}}\",\n  \"workflow_version\": \"{{workflow_version}}\",\n  \"content_hash\": \"{{content_hash}}\",\n  \"latitude\": {{pickup_latitude}},\n  \"longitude\": {{pickup_longitude}},\n  \"notes\": \"Departing empty from Pickup (Jeddah)\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/driver/jobs/movement/{{movement_job_id}}/actions/EM2/execute/",
        "description": "Fires EM2 action to log departure.\n\nPREREQUISITE: Run 04a EM1 first so pickup is complete.\nUse a fresh client_action_id each run (Postman {{$guid}})."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function requireVar(name) {",
              "    var v = pm.collectionVariables.get(name) || '';",
              "    if (!v || String(v).indexOf('{{') >= 0) {",
              "        throw new Error(name + ' is missing. Run 01 Login, then 02 Dashboard (or 02b Create), then 03 Job Detail before EM2.');",
              "    }",
              "    return v;",
              "}",
              "requireVar('movement_job_id');",
              "requireVar('content_hash');",
              "requireVar('workflow_version');",
              "requireVar('access_token');",
              "pm.collectionVariables.set('execute_client_action_id', 'em-depart-' + pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var resp = pm.response.json();",
              "var exec = (resp.data && resp.data.execution) || {};",
              "pm.test('Status code is 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "pm.test('EM2 not a stale cross-job replay', function () {",
              "    if (exec.replayed) {",
              "        var steps = (resp.data.workflow && resp.data.workflow.workflow_status) || [];",
              "        var inTransit = steps.find(function(s) { return s.step_key === 'in_transit'; });",
              "        pm.expect(inTransit && inTransit.completed, 'Replay must belong to this movement').to.eql(true);",
              "    } else { pm.expect(exec.replayed).to.eql(false); }",
              "});",
              "pm.test('Next action advances past EM2', function () {",
              "    var next = (resp.data.workflow && resp.data.workflow.next_action) || {};",
              "    pm.expect(next.action_code).to.eql('EM3');",
              "});",
              "if (resp.status === 1 && resp.data && resp.data.sync_metadata) {",
              "    pm.collectionVariables.set(\"content_hash\", resp.data.sync_metadata.content_hash);",
              "    pm.collectionVariables.set(\"workflow_version\", resp.data.sync_metadata.workflow_version);",
              "    pm.test(\"Sync hash updated from empty move execute\", function() { pm.expect(resp.data.sync_metadata.content_hash).to.exist; });",
              "}"
            ]
          }
        }
      ]
    },
