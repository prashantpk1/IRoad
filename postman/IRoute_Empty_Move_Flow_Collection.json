            "type": "text/javascript",
            "exec": [
              "var resp = pm.response.json();",
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "var status = (resp.data && resp.data.reconciliation && resp.data.reconciliation.authoritative_status) || (resp.data && resp.data.workflow && resp.data.workflow.workflow_metadata && resp.data.workflow.workflow_metadata.status_for_workflow) || \"\";",
              "pm.test(\"Movement status is Completed\", function() {",
              "    pm.expect(status).to.eql(\"Completed\");",
              "});",
              "pm.test(\"Allowed actions is empty\", function() {",
              "    var allowed = (resp.data && resp.data.workflow && resp.data.workflow.allowed_actions) || [];",
              "    pm.expect(allowed.length).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 — Execute Cancel Empty Move (Optional — Before Start Only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_action_id\": \"em-cancel-{{$guid}}\",\n  \"workflow_version\": \"{{workflow_version}}\",\n  \"content_hash\": \"{{content_hash}}\",\n  \"latitude\": 24.7136,\n  \"longitude\": 46.6753,\n  \"notes\": \"Empty move cancelled — plan changed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/driver/jobs/movement/{{movement_job_id}}/actions/A_EMPTY_CANCEL/execute/",
        "description": "OPTIONAL STEP — CANCEL BEFORE STARTING ONLY.\nNOTE: action_code for empty move cancel may be named differently.\nCheck Action Master in database for the exact code where:\n  scope = On_Call AND category = Empty_Move AND sequence_number = 3\nReplace A_EMPTY_CANCEL in URL with that exact code.\nIMPORTANT RULES:\n  - Cancel is ONLY allowed when status is Scheduled.\n  - Once In Progress cancel is NOT allowed.\n  - Once Completed cancel is NOT allowed.\nWhen cancelled:\n  Movement Log status = Cancelled\n  Row stays in storage for audit (never deleted)\n  Row is excluded from all KPI calculations\nUse this if the trip was planned but never happened.\n\nPREREQUISITE: Run empty move execute requests in order and do not skip steps. content_hash/workflow_version auto-update after each successful execute. If you get 409 stale_content_hash, re-run Request 03 then retry."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var resp = pm.response.json();",
              "if (resp.status === 1 && resp.data && resp.data.sync_metadata) {",
              "    pm.collectionVariables.set(\"content_hash\", resp.data.sync_metadata.content_hash);",
              "    pm.collectionVariables.set(\"workflow_version\", resp.data.sync_metadata.workflow_version);",
              "    pm.test(\"Sync hash updated from empty move execute\", function() { pm.expect(resp.data.sync_metadata.content_hash).to.exist; });",
              "}"
            ]
          }
        }
      ]
    },
