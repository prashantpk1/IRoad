              "        resp.data.content_hash",
              "    );",
              "    pm.collectionVariables.set(",
              "        \"pod_workflow_version\",",
              "        resp.data.workflow_version",
              "    );",
              "    pm.test(",
              "        \"POD sync hash saved\",",
              "        function() {",
