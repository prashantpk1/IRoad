  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "01 - Login (Email)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/driver/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driver_email}}\",\n  \"password\": \"{{driver_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var r = pm.response.json();",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('status=1', function () { pm.expect(r.status).to.eql(1); });",
                  "if (r.data && r.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', r.data.access_token);",
                  "  try { pm.environment.set('access_token', r.data.access_token); } catch (e) {}",
                  "}",
                  "if (r.data && r.data.refresh_token) {",
                  "  pm.collectionVariables.set('refresh_token', r.data.refresh_token);",
                  "  try { pm.environment.set('refresh_token', r.data.refresh_token); } catch (e) {}",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Dashboard (resolve assigned job)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "url": "{{base_url}}/driver/dashboard/"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var t = pm.variables.get('access_token') || pm.collectionVariables.get('access_token') || '';",
                  "if (!t || String(t).indexOf('{{') >= 0) { throw new Error('Run 01 Login first.'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "var d = (pm.response.json().data || {});",
                  "var active = d.active_job || {};",
                  "var current = d.current_job || {};",
                  "if (active.job_id) {",
                  "  var jt = active.job_type || 'shipment';",
                  "  pm.collectionVariables.set('job_id', active.job_id);",
                  "  pm.collectionVariables.set('job_type', jt);",
                  "  if (jt === 'booking') {",
                  "    pm.collectionVariables.set('booking_id', active.job_id);",
                  "  } else if (jt === 'shipment') {",
                  "    pm.collectionVariables.set('shipment_id', active.job_id);",
                  "  }",
                  "  try {",
                  "    pm.environment.set('job_id', active.job_id);",
                  "    pm.environment.set('job_type', jt);",
                  "    if (jt === 'booking') pm.environment.set('booking_id', active.job_id);",
                  "    else if (jt === 'shipment') pm.environment.set('shipment_id', active.job_id);",
                  "  } catch (e) {}",
                  "}",
                  "if (current.booking_id) {",
                  "  pm.collectionVariables.set('booking_id', current.booking_id);",
                  "  try { pm.environment.set('booking_id', current.booking_id); } catch (e) {}",
                  "}",
                  "if (active.job_no) {",
                  "  pm.collectionVariables.set('shipment_no', active.job_no);",
                  "  try { pm.environment.set('shipment_no', active.job_no); } catch (e) {}",
                  "}",
                  "pm.test('active_job object exists', function () { pm.expect(d.active_job || {}).to.be.an('object'); });"
                ]
              }
            }
          ]
        },
