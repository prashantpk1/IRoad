    {
      "name": "01 - Assigned Job Check",
      "item": [
        {
          "name": "Dashboard - assert assigned job visible",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
