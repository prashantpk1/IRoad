# .gitignore — exclude from VERSION CONTROL (what must never be committed)
#
# NOT the same as .dockerignore:
#   .gitignore  → Git commits only
#   .dockerignore → Docker image build only (see that file for tests/, .git/, etc.)

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.python-version
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.ipynb_checkpoints/
pip-log.txt
pip-delete-this-directory.txt
status.dat

# Virtual environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# ─────────────────────────────────────────────
