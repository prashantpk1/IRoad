# Line endings: store LF in git (fixes Windows CRLF warnings on Dockerfile, etc.)
* text=auto eol=lf

Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.txt text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.svg binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary
